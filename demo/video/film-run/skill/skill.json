{
  "skill_id": "halcyon-invoice-review",
  "version": 1,
  "title": "Review Halcyon Staffing invoice against contract and approved timecards",
  "created_at": "2026-11-11T06:37:02.368Z",
  "mode": "real",
  "recordings": [
    "rec_20261111T063450Z_sftc"
