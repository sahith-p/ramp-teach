  "vendor": "Halcyon Staffing",
  "rules": [
    {
      "id": "r1",
      "text": "No employee may appear on more than one labor line for the same week ending date.",
      "kind": "check",
      "source": "said",
      "citations": [
        {
          "utterance_id": "u3",
          "quote": "And nobody should be billed twice for the same week.",
          "step_index": 14,
          "selector": "a[href=\"/portal/employees/E-101?week=2026-10-11\"]",
          "url": "http://localhost:3000/portal/invoices/HSG-1010"
        }
      ]
    },
    {
      "id": "r2",
      "text": "For each labor line, billed hours must be less than or equal to the approved_hours shown on that employee's timecard for the billed week.",
      "kind": "check",
      "source": "said",
      "citations": [
        {
          "utterance_id": "u4",
          "quote": "Then I check each person's hours against their timecard.",
          "step_index": 14,
          "selector": "a[href=\"/portal/employees/E-101?week=2026-10-11\"]",
          "url": "http://localhost:3000/portal/invoices/HSG-1010"
        },
        {
          "utterance_id": "u6",
          "quote": "Billed hours can't go over that.",
          "step_index": 16,
          "selector": "[data-field=\"approved_hours\"]",
          "url": "http://localhost:3000/portal/employees/E-101?week=2026-10-11"
        }
      ]
    },
    {
      "id": "r3",
      "text": "If any check fails, recommend disputing the invoice and requesting a credit; otherwise the invoice passes review.",
      "kind": "decision",
      "source": "said",
      "citations": [
        {
          "utterance_id": "u8",
          "quote": "If anything is off, I dispute it and ask for a credit.",
          "step_index": 21,
          "selector": "[data-field=\"approved_hours\"]",
          "url": "http://localhost:3000/portal/employees/E-104?week=2026-10-11"
        }
      ]
    },
    {
      "id": "r4",
      "text": "Sign in to the Halcyon Staffing client portal, open the invoices list, and open the invoice under review by its invoice number.",
      "kind": "procedure",
      "source": "shown",
      "citations": [
        {
          "utterance_id": null,
          "quote": "Sign in",
          "step_index": 6,
          "selector": "main > div > form > button",
          "url": "http://localhost:3000/portal/login"
        },
        {
          "utterance_id": null,
          "quote": "HSG-1010",
          "step_index": 10,
          "selector": "a[href=\"/portal/invoices/HSG-1010\"]",
          "url": "http://localhost:3000/portal/invoices"
        }
      ]
    },
    {
      "id": "r5",
      "text": "For each person billed on the invoice, click that line's \"View timecard\" link to open the employee's timecard for the billed week, read the approved_hours field, then return to the invoice before opening the next person's timecard.",
      "kind": "procedure",
      "source": "both",
      "citations": [
        {
          "utterance_id": "u4",
          "quote": "Then I check each person's hours against their timecard.",
          "step_index": 14,
          "selector": "a[href=\"/portal/employees/E-101?week=2026-10-11\"]",
          "url": "http://localhost:3000/portal/invoices/HSG-1010"
        },
        {
